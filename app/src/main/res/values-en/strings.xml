    <string name="settings_app_info_title">Application Information</string>
    <string name="settings_app_version">Version %s (Official)</string>
    <string name="settings_app_info_p1">DocMask is a radical privacy utility designed to protect Spanish and European identity documents (DNI, Passport, NIE, driver\'s license) when sending them to third parties.</string>
    <string name="settings_app_info_p2">• 100% Offline Privacy: The application neither requests nor holds INTERNET permission in the operating system. Your confidential photos and data never leave your phone.</string>
    <string name="settings_app_info_p3">• Bundled On-Device AI: Smart local detection of support number, CAN code, signature, and face via Google ML Kit.</string>
    <string name="settings_app_info_p4">• Anti-Fraud Protection: One-tap interactive pixelation, grayscale conversion, and deterrent watermarking with custom date and specific purpose.</string>
    <string name="settings_open_app_settings">Open System Settings</string>
    <string name="settings_zero_network_title" formatted="false">Zero-Network Guarantee (100% Offline)</string>
    <string name="settings_zero_network_desc">DocMask has no INTERNET permission in its AndroidManifest.xml. The Android operating system itself prevents any data transmission. Your documents never leave your device.</string>

